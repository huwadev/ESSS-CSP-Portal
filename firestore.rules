rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: returns true if the calling user's hunter profile has status == 'active' or role == 'admin'.
    function isApprovedUser(appId) {
      let hunterDoc = /databases/$(database)/documents/artifacts/$(appId)/public/data/hunters/$(request.auth.uid);
      return exists(hunterDoc) && (
        get(hunterDoc).data.status == 'active' || 
        get(hunterDoc).data.role == 'admin'
      );
    }

    // Helper: returns true if the user is an active manager or admin.
    function isApprovedManager(appId) {
      let hunterDoc = /databases/$(database)/documents/artifacts/$(appId)/public/data/hunters/$(request.auth.uid);
      return exists(hunterDoc) && get(hunterDoc).data.status == 'active' && 
        (get(hunterDoc).data.role == 'manager' || get(hunterDoc).data.role == 'admin');
    }

    // Helper: returns true if the user is an active admin.
    function isApprovedAdmin(appId) {
      let hunterDoc = /databases/$(database)/documents/artifacts/$(appId)/public/data/hunters/$(request.auth.uid);
      return exists(hunterDoc) && get(hunterDoc).data.status == 'active' && 
        get(hunterDoc).data.role == 'admin';
    }

    // --- HUNTERS (profiles) ---
    match /artifacts/{appId}/public/data/hunters/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (request.auth.uid == uid || isApprovedAdmin(appId) || isApprovedManager(appId));
      allow delete: if request.auth != null && isApprovedAdmin(appId);
    }

    // --- TEAMS ---
    match /artifacts/{appId}/public/data/teams/{teamId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && isApprovedAdmin(appId);
      allow update: if request.auth != null && isApprovedUser(appId);
    }

    // --- INVITATIONS ---
    match /artifacts/{appId}/public/data/invitations/{inviteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isApprovedManager(appId);
      allow update: if request.auth != null && (
        (request.auth.token.email != null && (
          resource.data.email == request.auth.token.email || 
          resource.data.email == request.auth.token.email.lower()
        )) || 
        isApprovedManager(appId)
      );
      allow delete: if request.auth != null && isApprovedManager(appId);
    }

    // --- CAMPAIGNS ---
    match /artifacts/{appId}/public/data/campaigns/{campId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && isApprovedManager(appId);
      allow update: if request.auth != null && isApprovedUser(appId);
    }

    // --- IMAGE SETS ---
    match /artifacts/{appId}/public/data/image_sets/{setId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isApprovedUser(appId);
    }

    // --- RESOURCES ---
    match /artifacts/{appId}/public/data/resources/{resId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isApprovedManager(appId);
    }

    // --- SYSTEM LOGS ---
    match /artifacts/{appId}/public/data/system_logs/{logId} {
      allow read: if request.auth != null && isApprovedUser(appId);
      allow create: if request.auth != null;
    }

    // --- GLOBAL CHAT ---
    match /artifacts/{appId}/public/data/global_chat/{msgId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isApprovedUser(appId);
    }

    // --- TEAM CHAT ---
    match /artifacts/{appId}/public/data/team_chat/{msgId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isApprovedUser(appId);
    }

    // --- NOTIFICATIONS ---
    match /artifacts/{appId}/public/data/notifications/{notifId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isApprovedUser(appId);
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
